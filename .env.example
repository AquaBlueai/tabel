# Сервер порти
PORT=3000
# Сайтингизнинг тўлиқ HTTPS манзили (Telegram Mini App фақат HTTPS да ишлайди)
WEBAPP_URL=https://tabel.example.uz
# @BotFather дан олинган токен
BOT_TOKEN=123456789:AA...
# Янги ходим рўйхатдан ўтганда хабар олувчи HR лар chat ID си (ботга /id ёзиб билинади), вергул билан
ADMIN_CHAT_IDS=
# HR панелига кириш
ADMIN_USER=admin
ADMIN_PASSWORD=ўзгартиринг
# Узун тасодифий сатр (сессия имзоси учун)
SESSION_SECRET=
# Вақт зонаси
TZ_NAME=Asia/Tashkent
# Маълумотлар базаси файли
DB_PATH=./data/tabel.db
# ФАҚАТ локал синов учун: Telegram'сиз /app/ ни браузерда очиш. Продакшнда бўш қолдиринг!
DEV_TELEGRAM_ID=
